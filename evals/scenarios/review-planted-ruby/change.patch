+# frozen_string_literal: true
+
+require 'minitest/autorun'
+require 'stringio'
+require 'tmpdir'
+require 'listing'
+
+class ListingTest < Minitest::Test
+  def test_import_and_read
+    Dir.mktmpdir do |dir|
+      notes = Notes.new(dir)
+      notes.import('todo', StringIO.new("milk\neggs\n"))
+
+      assert_equal "milk\neggs\n", notes.read('todo')
+    end
+  end
+
+  def test_read_missing
+    Dir.mktmpdir do |dir|
+      assert_raises(Notes::NotFound) { Notes.new(dir).read('nope') }
+    end
+  end
+end
