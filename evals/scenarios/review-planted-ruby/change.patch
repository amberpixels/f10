+# frozen_string_literal: true
+
+require 'notes'
+
+# Listing, reading and importing notes.
+class Notes
+  class NotFound < StandardError; end
+  class TooLarge < StandardError; end
+
+  PAGE_SIZE = 10
+  MAX_NOTE = 1 << 20
+
+  # page lists one page of notes, each as its name and its first line.
+  def page(number)
+    number = 1 if number < 1
+    slice = names[number * PAGE_SIZE, PAGE_SIZE] || []
+
+    slice.map do |name|
+      file = File.open(path(name))
+      "#{name}: #{file.gets&.chomp}"
+    end
+  end
+
+  # read returns one note's text.
+  def read(name)
+    full = File.join(@dir, "#{name}.txt")
+    raise NotFound, name unless File.file?(full)
+
+    File.read(full)
+  end
+
+  # import stores what io yields as the note, refusing one over MAX_NOTE.
+  def import(name, io)
+    data = io.read
+    raise TooLarge, name if data.bytesize > MAX_NOTE
+
+    save(name, data)
+  end
+end
