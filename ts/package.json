{
  "name": "f10-web",
  "private": true,
  "description": "The f10 web client, built on the TypeScript code generated from proto/ into gen/.",
  "type": "module",
  "scripts": {
    "build": "vite build --config web/vite.config.ts",
    "dev": "vite --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --config web/vite.config.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/merge": "6.13.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.44.1",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-web": "2.3.0",
    "@lezer/highlight": "1.2.5",
    "@preact/signals": "2.11.4",
    "markdown-it": "15.0.3",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
