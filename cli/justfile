# Blocks between `# >>> justx:<id>` and `# <<< justx:<id>` are managed by justx.
# Edit anything outside the fences freely; `j @upgrade` (v2) re-syncs managed blocks.
#
# The Go half of f10: the root justfile loads this as the `cli` module, so `just fmt`
# at the root formats shell and Go while `just cli::fmt` (or `just fmt` from this
# directory) touches only Go. standardgo is pinned as a tool in tools/go.mod, its own
# module, so golangci-lint's dependency tree stays out of this module's go.mod.

# Default recipe: format (rewrites, decides nothing; `just fix` is the mutable one)
default: fmt

# >>> justx:fmt (managed) - `j @upgrade` re-syncs; remove these fences to take over
# format Go code - rewrites to canonical form
fmt:
    go tool -modfile=tools/go.mod standardgo fmt ./...
# <<< justx:fmt

# >>> justx:lint (managed) - `j @upgrade` re-syncs; remove these fences to take over
# lint Go code - reports findings, changes nothing
lint:
    go tool -modfile=tools/go.mod standardgo ./...
# <<< justx:lint

# >>> justx:fix (managed) - `j @upgrade` re-syncs; remove these fences to take over
# auto-fix what can be fixed - run on a clean tree and read the diff
fix:
    go tool -modfile=tools/go.mod standardgo ./... --fix
# <<< justx:fix

# >>> justx:test (managed) - `j @upgrade` re-syncs; remove these fences to take over
# run tests
test:
    go test ./...
# <<< justx:test

# >>> justx:build (managed) - `j @upgrade` re-syncs; remove these fences to take over
# build
build:
    go build ./...
# <<< justx:build

# >>> justx:ci (managed) - `j @upgrade` re-syncs; remove these fences to take over
# run all checks - read-only, safe for CI
ci: lint test
# <<< justx:ci

# run the prompt evals in ../evals against the real model ([docs/evals.md](../docs/evals.md))
eval *args:
    go run ./cmd/f10eval -root .. {{args}}

# build this checkout's binary into the cache slot the plugin's bin/f10 shim runs,
# and into $GOBIN so a bare `f10` in a terminal runs the same build
install:
    ../bin/f10 --shim-rebuild
    go install -ldflags "-X main.stampedVersion=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' ../.claude-plugin/plugin.json)" ./cmd/f10
