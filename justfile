# justfile - generated by justx · the justfile companion
# https://github.com/amberpixels/just-x
#
# f10 is a hybrid repo - bash in bin/ for the plugin, Go in cli/ for the binary -
# so each root recipe covers the shell half here and delegates the Go half to
# the `cli` module (cli/justfile). The justx fences were removed on purpose: a
# managed re-sync would pick one stack and drop the other, and `j @upgrade`
# never touches unfenced recipes.

mod cli

# machine-local recipes, untracked; absent is fine
import? 'justfile.local'

# Default recipe: format (rewrites, decides nothing; `just fix` is the mutable one)
default: fmt

# format shell + Go - rewrites to canonical form
fmt: cli::fmt
    shfmt -w -i 2 -ci .

# lint shell + Go - reports findings, changes nothing
lint: cli::lint
    shfmt -f . | xargs -r shellcheck
    shfmt -d -i 2 -ci .

# auto-fix what can be fixed - run on a clean tree and read the diff
fix: cli::fix
    shfmt -f . | xargs -r shellcheck -f diff | git apply --allow-empty
    shfmt -w -s -i 2 -ci .

# run tests - the f10-load-project.sh parity suite included
test: cli::test

# build the f10 binary
build: cli::build

# build this checkout's f10 binary into the shim's cache
install: cli::install

# run the prompt evals against the real model - costs spend and minutes; on demand and before a release, never in CI
eval *args:
    just cli::eval {{args}}

# run all checks - read-only, safe for CI
ci: lint test
