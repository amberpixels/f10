{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amberpixels/f10/docs/board.schema.json",
  "title": "Board",
  "description": "What changed in a project's window (the feed) or where every task stands (the state); docs/board.md is the spec.",
  "$ref": "#/$defs/Board",
  "$defs": {
    "Board": {
      "type": "object",
      "properties": {
        "version": {
          "const": 4
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "view": {
          "type": "string",
          "enum": [
            "feed",
            "state"
          ]
        },
        "project": {
          "$ref": "#/$defs/Project"
        },
        "window": {
          "$ref": "#/$defs/Window"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Source"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Row"
          }
        },
        "feed": {
          "$ref": "#/$defs/Feed"
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "generated_at",
        "view",
        "project",
        "window",
        "sources",
        "rows"
      ]
    },
    "Project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "enum": [
            "gh",
            "glab"
          ]
        },
        "checkout": {
          "type": "string"
        },
        "remote": {
          "type": "boolean"
        },
        "local_only": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "remote"
      ]
    },
    "Window": {
      "type": "object",
      "properties": {
        "since": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "chosen": {
          "type": "string"
        },
        "fallback": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "since"
      ]
    },
    "Source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "host",
            "tracker",
            "local"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "skipped": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "took_ms": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "ok",
        "took_ms"
      ]
    },
    "Row": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "task": {
          "$ref": "#/$defs/Task"
        },
        "stage": {
          "type": "string",
          "enum": [
            "asks-waiting",
            "blocked",
            "ready",
            "in-review",
            "pr-open",
            "implementing",
            "planned",
            "merged-unfinished",
            "next",
            "done"
          ]
        },
        "stage_from": {
          "type": "string",
          "enum": [
            "local",
            "trace",
            "tracker",
            "guessed"
          ]
        },
        "who": {
          "$ref": "#/$defs/Who"
        },
        "where": {
          "$ref": "#/$defs/Where"
        },
        "review": {
          "$ref": "#/$defs/ReviewFacts"
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "last_activity": {
          "type": "string",
          "format": "date-time"
        },
        "next": {
          "$ref": "#/$defs/Next"
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "stage",
        "stage_from",
        "who",
        "where",
        "next"
      ]
    },
    "Task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": [
            "urgent",
            "high",
            "medium",
            "low"
          ]
        },
        "assignee": {
          "type": "string"
        },
        "after": {
          "type": "string"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "Who": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string"
        },
        "agent_status": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "assignees": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "committers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "person": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Where": {
      "type": "object",
      "properties": {
        "pr": {
          "$ref": "#/$defs/PRRef"
        },
        "branch": {
          "type": "string"
        },
        "worktree": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        },
        "branch_left": {
          "type": "boolean",
          "description": "A merged row whose branch outlived its worktree."
        }
      },
      "additionalProperties": false
    },
    "PRRef": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "merged",
            "closed"
          ]
        },
        "draft": {
          "type": "boolean"
        },
        "head": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "mergeable": {
          "type": "string",
          "enum": [
            "clean",
            "conflicts",
            "blocked"
          ]
        },
        "checks": {
          "type": "string",
          "enum": [
            "green",
            "red",
            "pending"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "number",
        "state"
      ]
    },
    "ReviewFacts": {
      "type": "object",
      "properties": {
        "step": {
          "type": "string"
        },
        "round": {
          "type": "integer"
        },
        "open": {
          "type": "integer"
        },
        "asks": {
          "type": "integer"
        },
        "approvals": {
          "type": "integer"
        },
        "changes_requested": {
          "type": "integer"
        },
        "remote_open": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "Next": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Feed": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FeedRow"
          }
        },
        "quiet": {
          "$ref": "#/$defs/Quiet"
        }
      },
      "additionalProperties": false,
      "required": [
        "rows",
        "quiet"
      ]
    },
    "RelatedPR": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "merged",
            "closed"
          ]
        },
        "relation": {
          "type": "string",
          "enum": [
            "part",
            "follow-up",
            "replaced"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "number",
        "state",
        "relation"
      ]
    },
    "Quiet": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer"
        },
        "oldest": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "required": [
        "count"
      ]
    },
    "FeedRow": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string",
          "enum": [
            "started",
            "updated",
            "reviewed",
            "finished",
            "new-tasks"
          ]
        },
        "key": {
          "type": "string"
        },
        "task": {
          "$ref": "#/$defs/Task"
        },
        "pr": {
          "$ref": "#/$defs/PRRef"
        },
        "from": {
          "type": "string",
          "enum": [
            "local",
            "trace",
            "host",
            "tracker",
            "guessed"
          ]
        },
        "who": {
          "$ref": "#/$defs/Who"
        },
        "owes": {
          "type": "string"
        },
        "abandoned": {
          "type": "boolean"
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RelatedPR"
          }
        },
        "summary": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "required": [
        "group",
        "key",
        "from",
        "who",
        "at"
      ]
    }
  }
}
